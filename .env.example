# Public HTTPS URL of this deployment (localhost is allowed for development only)
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
MCP_TRANSPORT=http

# PostgreSQL
DATABASE_URL=postgresql://bitrix_mcp:change-me@localhost:5432/bitrix_mcp
DATABASE_SSL=false

# Create a local/public Bitrix24 OAuth app for each deployment (BYO OAuth app)
# During the first API-only installation, pending-bitrix-app/pending-bitrix-secret
# permits app.info validation before Bitrix24 reveals the final credentials.
# Replace both immediately after Bitrix24 displays them.
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Portal used by the automatic MCP -> Bitrix24 OAuth redirect. This exact value
# also allowlists a custom portal domain. Optional only when one hosted portal
# connection already exists in the database.
BITRIX_PORTAL_DOMAIN=

# Safe defaults. Reconnect a portal with ?mode=write_with_confirmation to enable prepared writes.
BITRIX_MCP_DEFAULT_MODE=read_only
BITRIX_MCP_ADMIN_TOOLS=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Generate a separate value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

OAUTH_STATE_TTL_SECONDS=600
MCP_OAUTH_REQUEST_TTL_SECONDS=600
MCP_OAUTH_CODE_TTL_SECONDS=300
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
SCHEMA_CACHE_TTL_SECONDS=900
PENDING_OPERATION_TTL_SECONDS=600
BITRIX_REQUEST_TIMEOUT_MS=15000
BITRIX_MAX_RETRIES=3
BITRIX_MAX_PAGES=20
